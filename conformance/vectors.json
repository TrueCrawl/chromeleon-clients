    "measured": "2026-08-12",
    "python": "chromeleon.core.parse_proxy (CPython 3.12)",
    "node": "src/core.parseProxy (Node 18)",
    "server_oracle": "playwright-core 1.59.1 normalizeProxySettings",
    "rulings": "conformance/RULINGS.md"
  },
  "error_kinds": {
    "invalid_server": "the server is not a URL, has no host, or has a bad port",
    "missing_server": "no server was given",
    "undecodable_credential": "a URL credential percent-decodes to non-UTF-8 bytes"
  },
